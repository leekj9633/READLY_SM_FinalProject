

import google.generativeai as genai
import json

genai.configure(api_key="AQ.Ab8RN6I1ORNd0jne_bCh90QHewK2I6Abn8PtrnoAQbBjgE3crQ")
model = genai.GenerativeModel("gemini-1.5-flash")

def extract_slots(stt_text: str) -> dict:
    prompt = f"""
당신은 교통약자 이동상담 앱의 정보 추출 AI입니다.
사용자 발화에서 아래 항목을 추출해 JSON으로만 반환하세요.
추출 불가 항목은 null로 반환하세요.
절대 추측하거나 없는 내용을 만들지 마세요.

추출 항목:
- destination: 목적지 장소명
- condition: 오늘 컨디션
  ("무릎 통증" / "숨참" / "짐 있음" / "더위 약함" / "길찾기 불안" / null)
- departure_time: 출발 시간 ("오늘" / "지금" / 구체적 시간 / null)
- is_alone: 혼자 이동 여부 (true / false / null)

사용자 발화: {stt_text}

JSON만 반환:
"""
    response = model.generate_content(prompt)
    
    # JSON 파싱
    text = response.text.strip()
    text = text.replace("```json", "").replace("```", "").strip()
    return json.loads(text)

# 테스트
test_cases = [
    "아주대병원 가고 싶어",
    "오늘 무릎이 아파서 병원 가야 해",
    "수원역 근처 병원인데 혼자 가기 좀 불안해",
]

for text in test_cases:
    result = extract_slots(text)
    print(f"입력: {text}")
    print(f"출력: {result}\n")